# Exchange Credentials & Environment Configuration
# Copy this file to .env and insert your exchange keys for live trading mode.

# Hyperliquid Private Key (Ethereum wallet key for DEX API calls)
HYPERLIQUID_SECRET_KEY=0x...

# Aster Exchange Credentials
ASTER_API_KEY=your_aster_api_key_here
ASTER_API_SECRET=your_aster_api_secret_here

# Binance API Credentials (Optional if only reading public funding streams)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
