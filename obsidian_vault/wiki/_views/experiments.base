# Experiments: Pre-registrations, archived controls and verdicts.
# Generated by knowledge.views (Round 101); regenerate with `python -m knowledge.views --force`.
filters:
  and:
  - file.inFolder("wiki/experiments")
  - file.ext == "md"
properties:
  title:
    displayName: title
  status:
    displayName: status
  tags:
    displayName: tags
views:
- type: table
  name: Experiments
  order:
  - file.name
  - title
  - status
  - tags
