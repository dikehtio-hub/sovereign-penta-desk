# Rulings: Every Ruling page: the R-series and every extracted Directive / Ratification / Ruling N-N.
# Generated by knowledge.views (Round 101); regenerate with `python -m knowledge.views --force`.
filters:
  and:
  - file.inFolder("wiki/rulings")
  - file.ext == "md"
properties:
  title:
    displayName: title
  status:
    displayName: status
  stale_after:
    displayName: stale after
  tags:
    displayName: tags
views:
- type: table
  name: Rulings
  order:
  - file.name
  - title
  - status
  - stale_after
  - tags
