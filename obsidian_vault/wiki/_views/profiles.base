# Reaction profiles: Post-print depth survival, one page per event x market.
# Generated by knowledge.views (Round 101); regenerate with `python -m knowledge.views --force`.
filters:
  and:
  - file.inFolder("wiki/profiles")
  - file.ext == "md"
properties:
  title:
    displayName: title
  status:
    displayName: status
views:
- type: table
  name: Reaction profiles
  order:
  - file.name
  - title
  - status
