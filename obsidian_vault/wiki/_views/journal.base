# Journal: One page per trading day: executions, calibration ledger, debrief.
# Generated by knowledge.views (Round 101); regenerate with `python -m knowledge.views --force`.
filters:
  and:
  - file.inFolder("journal")
  - file.ext == "md"
properties:
  title:
    displayName: title
  status:
    displayName: status
views:
- type: table
  name: Journal
  order:
  - file.name
  - title
  - status
