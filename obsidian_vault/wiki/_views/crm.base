# CRM: Titans, whales, sharps and sportsbooks; judgement is human, evidence appended.
# Generated by knowledge.views (Round 101); regenerate with `python -m knowledge.views --force`.
filters:
  and:
  - file.inFolder("crm")
  - file.ext == "md"
properties:
  type:
    displayName: type
  title:
    displayName: title
  status:
    displayName: status
views:
- type: table
  name: CRM
  order:
  - file.name
  - type
  - title
  - status
