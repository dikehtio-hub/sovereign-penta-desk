# Markets: Polymarket markets the wiki is bound to; deprecated when the token leaves the drops.
# Generated by knowledge.views (Round 101); regenerate with `python -m knowledge.views --force`.
filters:
  and:
  - file.inFolder("wiki/markets")
  - file.ext == "md"
properties:
  title:
    displayName: title
  status:
    displayName: status
  resource:
    displayName: resource
views:
- type: table
  name: Markets
  order:
  - file.name
  - title
  - status
  - resource
