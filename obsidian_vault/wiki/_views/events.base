# Events: Scheduled prints with their windows, tax deadlines, recorded events.
# Generated by knowledge.views (Round 101); regenerate with `python -m knowledge.views --force`.
filters:
  and:
  - file.inFolder("wiki/events")
  - file.ext == "md"
properties:
  title:
    displayName: title
  status:
    displayName: status
  stale_after:
    displayName: stale after
views:
- type: table
  name: Events
  order:
  - file.name
  - title
  - status
  - stale_after
