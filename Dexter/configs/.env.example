# ==========================================
# Dexter Environment Configuration
# ==========================================

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Antigravity Workspace / Settings
ANTIGRAVITY_WORKSPACE_PATH=C:/Users/ixis1/Desktop/DEV

# Obsidian Vault Path (the real vault lives at Desktop/Dexter, a sibling of DEV/)
OBSIDIAN_VAULT_PATH=C:/Users/ixis1/Desktop/Dexter

# Default Model Selection for Dispatcher (gemini-2.0-flash, gemini-1.5-pro, claude-3-7-sonnet, claude-3-5-haiku)
DEFAULT_FAST_MODEL=gemini-2.0-flash
DEFAULT_REASONING_MODEL=claude-3-7-sonnet
DEFAULT_MULTIMODAL_MODEL=gemini-1.5-pro

# Obsidian Local REST API Plugin (Optional for live HTTP API syncing)
# OBSIDIAN_API_KEY=your_obsidian_local_rest_api_key_here
# OBSIDIAN_API_PORT=27124
